from typing import Self,overload

__all__ = ("Color",)

class Color:
    __slots__ = ("r", "g", "b", "a")
    @overload
    def __new__(cls, r:str)->Self:...
    @overload
    def __new__(cls, r:int|float, g:int|float, b:int|float, a:float=1.0)->Self:...
    def __repr__(self)->str:...
    def __str__(self)->str:...
    def to_rgb(self)->tuple[int,int,int]:...
    def to_rgba(self)->tuple[int,int,int,float]:...
    def to_rgb_str(self)->str:...
    def to_rgba_str(self)->str:...
    def to_hex(self, with_alpha:bool|None=None, upper:bool=False)->str:...