from typing import Self, overload

from numpy import floating, integer

__all__ = ("Color",)
type Type_Int = int | integer
type Type_Real = int | integer | float | floating

class Color:
    __slots__ = ("r", "g", "b", "a")
    @overload
    def __new__(cls, r: str) -> Self: ...
    @overload
    def __new__(cls, r: Type_Int, g: Type_Int, b: Type_Int) -> Self: ...
    @overload
    def __new__(
        cls, r: Type_Int, g: Type_Int, b: Type_Int, a: Type_Real = ...
    ) -> Self: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    def to_rgb(self) -> tuple[int, int, int]: ...
    def to_rgba(self) -> tuple[int, int, int, float]: ...
    def to_rgb_str(self) -> str: ...
    def to_rgba_str(self) -> str: ...
    def to_hex(self, with_alpha: bool | None = ..., upper: bool = ...) -> str: ...
